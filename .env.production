# 本番ビルド（npm run build）だけが読む。開発の .env.development はここに効かない。
# 「30」ボタン・掲示板・募集リンクの三十オリジンは、この1行がビルド時に JS に埋め込まれる。
# 別の thirty（例: 別 Vercel プロジェクト）へ変えたいときだけここを書き換え、必ず
#   npm run build
#   firebase deploy --only hosting
# https のオリジンのみ（末尾 / はあっても無くてもよい。コード側で正規化される）
VITE_SANJUU_HTTP_BASE=https://sanjuu-ws.onrender.com
VITE_SANJUU_WEB_ORIGIN=https://sanjuu-941052820154.asia-northeast1.run.app
# GA4 — らくだ喫茶（本家）プロパティ
VITE_GA_MEASUREMENT_ID=G-6RVTDYWPEV
# 緑のゲート Stripe 決済 UI（年パス配布完了後に開放 — 2026-06-05）
VITE_STRIPE_GREEN_GATE_ENABLED=1

# 募金箱（Stripe Payment Link — チャット・Git に載せない）
VITE_DONATION_ENABLED=1
VITE_STRIPE_DONATION_PAYMENT_LINK=https://buy.stripe.com/6oU00j7hXavGaPl6AA00000
