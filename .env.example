# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# 30SANJUU（SANJUU ws / Next web）連携：連絡帳から募集・参加で開く先
# SANJUU の HTTP API（既定 http://localhost:8080）
VITE_SANJUU_HTTP_BASE=http://localhost:8080
# SANJUU Next のオリジン（末尾 / あってもよい）。ボタン・リンクは sanjuuWebOrigin() がこれを参照。
# 開発: リポジトリ直下の .env.development に書く（例: http://localhost:3200/）。未設定時のコード既定も 3200。
# 本番: .env.production で公開 URL のみ（例: https://sanjuu-….run.app）。localhost を本番ビルドに混ぜないこと。
# Firestore ルールを変えたときは `pnpm run deploy:hosting:with-rules`（または `deploy:firestore:rules`）で本番ルールも合わせること。
VITE_SANJUU_WEB_ORIGIN=http://localhost:3200/

# 三十フロントが「らくだのプロフィール API」を叩くときのベース（未コミットの三十 UI 含む）。
# 開発ではらくだを `npm run dev`（既定 http://localhost:5173）で動かすと、Vite が GET /api/me/profile を JSON で返す（HTML にならない）。
# Firebase 連携の本物が要るときは `PORT=8787` などで `node server.mjs` を別起動し、将来はプロキシでつなぐ想定。
# NEXT_PUBLIC_RAKUDA_ORIGIN=http://localhost:5173

# 逆プロキシ（らくだ珈琲 server.mjs）：/sanjuu/* と /ws を三十へ流す
# SANJUU web (Next) の HTTP オリジン
SANJUU_WEB_PROXY_TARGET=http://localhost:3000
# SANJUU ws エンジンの /ws（WS URL）
SANJUU_WS_PROXY_TARGET=ws://localhost:8080/ws

# 緑のゲート Stripe（server.mjs — チャット・Git に載せない）
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_GREEN_PRICE_ID=price_...
# APP_PUBLIC_ORIGIN=https://rakuda.coffee

# Cloud Run rakuda-api デプロイ用（Git に載せない）— scripts/deploy-rakuda-api.mjs が読む
# .env.rakuda-api.local に STRIPE_* / APP_PUBLIC_ORIGIN を書いて npm run deploy:rakuda-api

# クライアント：本番決済 UI を出すときだけビルド前に 1
# VITE_STRIPE_GREEN_GATE_ENABLED=1
# Stripe 商品は「480円／3か月（暦）」の Price ID を STRIPE_GREEN_PRICE_ID に設定

# AdSense サイト審査通過後に 1 — 審査中は全面広告プレースホルダーを出さない
# VITE_ADSENSE_SITE_APPROVED=1

# トップメニュー「らくだの記事」→ note プロフィール（未設定なら「準備中」トースト）
# VITE_RAKUDA_NOTE_URL=https://note.com/your_account

# 募金箱（Stripe Payment Link・可変金額 — チャット・Git に載せない）
# ダッシュボードで Payment Link 作成 →「お客様が金額を決める」→ 成功 URL: https://rakuda.coffee/?donation=thanks
# VITE_DONATION_ENABLED=1
# VITE_STRIPE_DONATION_PAYMENT_LINK=https://buy.stripe.com/...
