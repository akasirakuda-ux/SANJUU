{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/_next/**",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/icon.svg",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/api/rakuda-profile",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/api/room",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/api/play/**",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/api/dev/**",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/api/admin/**",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/api/ads",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/api/ads/**",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/api/bulletin-pins",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/api/bulletin-pins/**",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/world",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/world/**",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/notes",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/notes/**",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/play",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/play/**",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/r/**",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/sanjuu",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/sanjuu/**",
        "run": { "serviceId": "sanjuu", "region": "asia-northeast1" }
      },
      {
        "source": "/api/stripe/**",
        "run": { "serviceId": "rakuda-api", "region": "asia-northeast1" }
      },
      {
        "source": "/api/green-pass/**",
        "run": { "serviceId": "rakuda-api", "region": "asia-northeast1" }
      },
      {
        "source": "/api/session",
        "run": { "serviceId": "rakuda-api", "region": "asia-northeast1" }
      },
      {
        "source": "/api/session/**",
        "run": { "serviceId": "rakuda-api", "region": "asia-northeast1" }
      },
      {
        "source": "/api/robo-pickup/**",
        "run": { "serviceId": "rakuda-api", "region": "asia-northeast1" }
      },
      {
        "source": "/api/relay-story/**",
        "run": { "serviceId": "rakuda-api", "region": "asia-northeast1" }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}

